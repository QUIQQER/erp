<quiqqer>
    <package>

        <title>
            <locale group="quiqqer/erp" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/erp" var="package.title"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="erp.process-tracking">
                <title>Cross-document ERP process tracking</title>
                <description>
                    Groups related ERP documents and transactions into unified processes with chronological histories.
                </description>
            </capability>

            <capability id="erp.price-calculation">
                <title>ERP article and price calculation</title>
                <description>
                    Calculates article lists, price factors, discounts, VAT and net or gross totals for ERP entities.
                </description>
            </capability>

            <capability id="erp.document-output">
                <title>ERP document output</title>
                <description>
                    Renders ERP entities through configurable templates for HTML, PDF, download and email delivery.
                </description>
            </capability>

            <capability id="commerce.manufacturer-management">
                <title>Manufacturer management</title>
                <description>
                    Creates, searches and manages manufacturer accounts for product and ERP workflows.
                </description>
            </capability>

            <capability id="finance.company-bank-accounts">
                <title>Company bank account management</title>
                <description>
                    Stores company bank accounts and resolves configured default accounts for ERP documents.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/erp/bin/images/Logo.png"/>

        <erp>
            <type>application</type> <!-- application, module, plugin -->
        </erp>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/erp/bin/preview-1.png"/>
            <image src="URL_OPT_DIR/quiqqer/erp/bin/preview-2.png"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/erp]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/erp/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/erp/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0+]]></license>
        </copyright>

        <provider>
            <erp src="\QUI\ERP\Provider\Erp"/>
            <requirements src="\QUI\ERP\Provider\Requirements"/>
            <dashboard src="\QUI\ERP\Provider\DashboardProvider"/>
        </provider>
    </package>
</quiqqer>
